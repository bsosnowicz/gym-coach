# Serwer. Brak kont i logowania, wiec domyslnie slucha tylko lokalnie.
HOST=127.0.0.1
PORT=3001

# LLM glowny: Gemini przez endpoint zgodny z OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=
# Dozwolone wartosci zaleza od modelu (np. "minimal" dziala na Flash Lite, a inne modele je odrzucaja).
GEMINI_REASONING_EFFORT=

# Groq: rozpoznawanie mowy (Whisper) oraz zapasowy LLM, gdy Gemini milczy.
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_MODEL=
GROQ_REASONING_EFFORT=

# ElevenLabs: synteza mowy.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# LiveAvatar (tryb Lite): renderuje twarz z gotowego dzwieku.
LIVEAVATAR_API_KEY=
# Sandbox jest domyslny i nie zuzywa kredytow. Wpisz false, zeby uzyc prawdziwego awatara.
LIVEAVATAR_SANDBOX=true
# W sandboxie puste = awatar Wayne (jedyny obslugiwany). Poza sandboxem wymagane.
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VIDEO_QUALITY=
LIVEAVATAR_SESSION_LIMIT_S=

# Progi czasowe (ms), strojone na zywo.
LLM_FIRST_TOKEN_TIMEOUT_MS=
LLM_HEDGE_DELAY_MS=
TURN_TIMEOUT_MS=
STT_TIMEOUT_MS=

# Kamera (opcjonalnie): adres strumienia serwisu yolo-backend. Pusty = bez kamery.
# Lokalnie: ws://localhost:8000/ws/analyze; za Nginx na tym samym hoście: /yolo/ws/analyze
YOLO_POSE_WS_URL=
